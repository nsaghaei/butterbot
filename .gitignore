# Dependencies, model environments and private game history.
**/node_modules/
**/.venv/
**/__pycache__/
**/*.pyc
**/.env
**/.env.*
!**/.env.example
**/*.log
**/saved/
**/evidence/
**/debug/history.jsonl
**/debug-report*.json

# Keep the Maker Garden app, not other workspace experiments.
/outputs/*
!/outputs/maker/
/outputs/maker/releases/*
!/outputs/maker/releases/v6/
!/outputs/maker/releases/v8/
!/outputs/maker/releases/v9/
!/outputs/maker/releases/v10/
!/outputs/maker/releases/v11/
!/outputs/maker/releases/v12/
!/outputs/maker/releases/v13/
!/outputs/maker/releases/v14/
!/outputs/maker/releases/v15/
!/outputs/maker/releases/v16/
!/outputs/maker/releases/v17/
!/outputs/maker/releases/v18/
!/outputs/maker/releases/v19/
!/outputs/maker/releases/v20/
!/outputs/maker/releases/v21/
!/outputs/maker/releases/v22/
!/outputs/maker/releases/v23/
!/outputs/maker/releases/v24/
!/outputs/maker/releases/v25/
!/outputs/maker/releases/v26/
!/outputs/maker/releases/v27/
!/outputs/maker/releases/v28/
!/outputs/maker/releases/v29/
!/outputs/maker/releases/v30/

# Keep reproducible build scripts, not downloads, scratch patches or model files.
/work/*
!/work/build-ui.cjs
!/work/ui-main.mjs
!/work/ui-scene.mjs
!/work/freeze-release.ps1

.DS_Store
Thumbs.db
